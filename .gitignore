# Configuración local con secretos — NUNCA subir
backend/config/.env

# Datos reales de producción (firmas, códigos, caché de víctimas).
# Se mantienen fuera de git: en producción NO deben sobrescribirse.
backend/data/*
!backend/data/.gitkeep

# Logs de seguridad
backend/logs/

# Memoria de trabajo del asistente / notas de sesión
.opencode/

# IDE / editor
.vscode/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales / pruebas
*.tmp
*.bak
