# Configuración local con secretos — NUNCA subir
backend/config/.env

# Datos reales de producción (firmas, códigos, caché de víctimas).
# Se mantienen fuera de git: en producción NO deben sobrescribirse.
backend/data/*
!backend/data/.gitkeep
# Contenido publicado (no es dato de usuario): seed de opiniones del público
!backend/data/opinions.json

# Logs de seguridad
backend/logs/

# Adjuntos de usuarios del formulario de opinión (contenido generado)
uploads/*
!uploads/.gitkeep

# Memoria de trabajo del asistente / notas de sesión
.opencode/

# IDE / editor
.vscode/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales / pruebas
*.tmp
*.bak

# Pack de stickers y script de pruebas de correo
fp-*.zip
backend/test_emails.php
