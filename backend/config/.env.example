# VARIABLES DE ENTORNO — copia este archivo como `.env` y rellena los valores reales.
# IMPORTANTE: nunca subas `.env` con credenciales reales a un repositorio.

# CIFRADO DE DATOS (AES-256-CBC)
# Genera una clave segura con: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=REEMPLAZA_CON_CLAVE_HEX_64_CARACTERES
CIPHER_METHOD=AES-256-CBC
FILENAME_JSON=data/signatures.json
FILENAME_JSON_CODE=data/codes.json

# EMAILJS
# Dashboard: https://dashboard.emailjs.com
USER_ID_EMAILJS=REEMPLAZA_CON_USER_ID
# Private Key (solo necesaria si en el dashboard está activado el "strict mode"
# de API access from non-browser environments). Dashboard → Account → API Keys.
#EMAILJS_PRIVATE_KEY=REEMPLAZA_CON_PRIVATE_KEY
EMAILJS_SERVICE_ID=service_XXXXXXXXXXX
EMAILJS_TEMPLATE_ID_USER=template_XXXXXXXXXXX
EMAILJS_TEMPLATE_ID_NOTIFICATION=template_XXXXXXXXXXX
FP_EMAIL=tu_correo_admin@ejemplo.com
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_CURL_TIMEOUT=10

# TRANSPORTE DE CORREO (emailjs | smtp)
# - emailjs: usa la API de EmailJS (límite gratis ~200 correos/mes)
# - smtp:    envía desde tu propio servidor SMTP (p. ej. Gmail: 500 correos/día)
EMAIL_PROVIDER=emailjs

# SMTP (Gmail: smtp.gmail.com, puerto 465 ssl o 587 tls)
# SMTP_PASS debe ser una CONTRASEÑA DE APLICACIÓN de Google, no la normal:
# Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=CONTRASEÑA_DE_APLICACIÓN_16_CARACTERES
SMTP_FROM=tu_correo@gmail.com
SMTP_FROM_NAME=FreePalestine

# CORS Y HOSTS
# ALLOWED_HOSTS: dominios desde los que se sirve la web (sin https://)
# CORS_ALLOWED_ORIGINS: orígenes permitidos para el proxy de correo (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000

# TRUST_PROXY_IP_HEADER: SOLO descomentar si el servidor está detrás de un
# reverse-proxy de confianza (Apache mod_proxy, Nginx, Cloudflare...).
# El valor es la clave de $_SERVER que contiene la IP real del cliente:
#   - Apache/Nginx:  HTTP_X_FORWARDED_FOR
#   - Cloudflare:    HTTP_CF_CONNECTING_IP
# Si queda comentado, se usa REMOTE_ADDR (IP directa del cliente).
#TRUST_PROXY_IP_HEADER=HTTP_X_FORWARDED_FOR

# RATE LIMITING (ventana en segundos / nº máximo de peticiones)
SIG_RATE_LIMIT_WINDOW=60
SIG_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_WINDOW=60
EMAIL_RATE_LIMIT_MAX=5

# LOGS (tamaño total máximo de todos los logs en bytes)
LOG_MAX_TOTAL_SIZE=104857600

# SEGURIDAD (tamaño máximo del JSON al leerlo en bytes)
JSON_MAX_READ_SIZE=10485760
